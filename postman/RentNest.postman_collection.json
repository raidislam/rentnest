    {
      "name": "Payment Callbacks (SSLCommerz)",
      "description": "These are called by SSLCommerz, not by the frontend. They are public (no token). SSLCommerz sends form data (x-www-form-urlencoded). Success is only accepted after server-side validation of val_id with SSLCommerz.",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Payment Success",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/success",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "success"
              ]
            },
            "description": "SSLCommerz redirects here after a successful payment. The server validates val_id with SSLCommerz before completing the payment and setting the rental to ACTIVE.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{transactionId}}",
                  "type": "text"
                },
                {
                  "key": "val_id",
                  "value": "<val_id from SSLCommerz>",
                  "type": "text"
                }
              ]
            }
          }
        },
