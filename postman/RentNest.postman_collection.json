      "item": [
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            },
            "description": "List all property categories. Saves the first category ID into `categoryId` (used by Create Property)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.length > 0) {",
                  "  pm.collectionVariables.set(\"categoryId\", res.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Available Properties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ]
            },
            "description": "List all available properties (availability = true)."
          }
        },
        {
          "name": "Filter by Location",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?location=dhaka",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ],
              "query": [
                {
                  "key": "location",
                  "value": "dhaka"
                }
              ]
            },
            "description": "Case-insensitive partial match on location."
          }
        },
        {
          "name": "Filter by Price Range",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?minPrice=5000&maxPrice=20000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ],
              "query": [
                {
                  "key": "minPrice",
                  "value": "5000"
                },
                {
                  "key": "maxPrice",
                  "value": "20000"
                }
              ]
            },
            "description": "minPrice/maxPrice must be numbers >= 0 and minPrice <= maxPrice, otherwise 400."
          }
        },
        {
          "name": "Filter by Property Type",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?propertyType=apartment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ],
              "query": [
                {
                  "key": "propertyType",
                  "value": "apartment"
                }
              ]
            },
            "description": "Case-insensitive exact match on propertyType."
          }
        },
        {
          "name": "Filter by Amenity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?amenity=WiFi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ],
              "query": [
                {
                  "key": "amenity",
                  "value": "WiFi"
                }
              ]
            },
            "description": "Returns properties whose amenities list contains this value."
          }
        },
        {
          "name": "Combined Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?location=dhaka&minPrice=1000&maxPrice=50000&propertyType=apartment&amenity=WiFi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ],
              "query": [
                {
                  "key": "location",
                  "value": "dhaka"
                },
                {
                  "key": "minPrice",
                  "value": "1000"
                },
                {
                  "key": "maxPrice",
                  "value": "50000"
                },
                {
                  "key": "propertyType",
                  "value": "apartment"
                },
                {
                  "key": "amenity",
                  "value": "WiFi"
                }
              ]
            },
            "description": "All filters can be combined."
          }
        },
        {
          "name": "Invalid Query (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties?minPrice=abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ],
              "query": [
                {
                  "key": "minPrice",
                  "value": "abc"
                }
              ]
            },
            "description": "Example of query validation. Returns 400 Validation error."
          }
        },
