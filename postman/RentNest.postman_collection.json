{
  "info": {
    "name": "RentNest API",
    "description": "API documentation for the RentNest rental marketplace backend.\n\nHow to use:\n1. Set `baseUrl` (local: http://localhost:5000, or the live Vercel URL).\n2. Run the Login requests in the Auth folder. Their test scripts save `tenantToken`, `landlordToken` and `adminToken` automatically.\n3. Each folder uses the matching Bearer token, so you don't need to copy tokens by hand.\n4. Create requests save IDs (propertyId, rentalRequestId, paymentId, categoryId) into collection variables.\n\nAll error responses use the shape: { success: false, message, errorDetails }.\nValidation errors return 400 with message \"Validation error\" and a list of { field, message } in errorDetails.\n\nSuggested demo order:\nLogin (all roles) -> Get Categories -> Landlord: Create Property -> Tenant: Create Rental Request -> Landlord: Approve Rental Request -> Tenant: Create Payment (open paymentUrl and pay in SSLCommerz sandbox) -> Tenant: Get Payment History -> Tenant: Complete Rental -> Tenant: Create Review -> Landlord: Get My Reviews.\n\nPasswords in this collection are placeholders. Replace them with real values in your own environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "tenantToken",
      "value": ""
    },
    {
      "key": "landlordToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "tenantEmail",
      "value": "tenant@rentnest.com"
    },
    {
      "key": "tenantPassword",
      "value": "<tenant-password>"
    },
    {
      "key": "landlordEmail",
      "value": "landlord@rentnest.com"
    },
    {
      "key": "landlordPassword",
      "value": "<landlord-password>"
    },
    {
      "key": "adminEmail",
      "value": "admin@rentnest.com"
    },
    {
      "key": "adminPassword",
      "value": "<admin-password>"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "propertyId",
      "value": ""
    },
    {
      "key": "rentalRequestId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Register, login and profile endpoints.",
      "item": [
        {
          "name": "Register Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Create a new TENANT account. Role can be TENANT or LANDLORD (ADMIN cannot be registered).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Tenant\",\n  \"email\": \"newtenant@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"TENANT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Register Landlord",
