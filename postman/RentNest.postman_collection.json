        {
          "name": "Create Payment (SSLCommerz)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "create"
              ]
            },
            "description": "Start an SSLCommerz payment for an APPROVED rental request. Returns `paymentUrl` - open it in a browser to pay. A FAILED or PENDING payment can be retried (new transaction ID). A COMPLETED payment returns 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rentalRequestId\": \"{{rentalRequestId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set(\"paymentId\", res.data.paymentId);",
                  "  pm.collectionVariables.set(\"transactionId\", res.data.transactionId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "confirm"
              ]
            },
            "description": "Manually confirm a payment using tran_id and val_id from SSLCommerz. The server validates val_id with SSLCommerz (status, tran_id, amount, currency) before marking the payment COMPLETED and the rental ACTIVE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tran_id\": \"{{transactionId}}\",\n  \"val_id\": \"<val_id from SSLCommerz>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get Payment History",
          "request": {
            "method": "GET",
